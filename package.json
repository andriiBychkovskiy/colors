{
  "name": "kids-colors-app",
  "version": "1.0.0",
  "description": "Kids Colors app - Full stack application with React frontend and Node.js backend",
  "main": "backend/server.js",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "install:all": "npm install && npm install --prefix react",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon backend/server.js",
    "dev:frontend": "npm run dev --prefix react",
    "build": "npm run build --prefix react",
    "start": "node backend/server.js",
    "migrate": "node backend/scripts/migrate-data.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "multer": "^1.4.5-lts.1",
    "concurrently": "^8.2.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
